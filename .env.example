# Chat with Ollama - Environment Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# OLLAMA CONFIGURATION (Required for local AI inference)
# =============================================================================

# Local Ollama API URL (default: http://localhost:11434/api/)
OLLAMA_API_URL=http://localhost:11434/api/

# JWT Token for authentication (optional - leave empty if not needed)
OLLAMA_JWT_TOKEN=

# Ollama Cloud API (optional - for cloud-based Ollama)
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODE=false

# =============================================================================
# MULTI-PROVIDER API KEYS (Optional - for cloud-based AI services)
# =============================================================================

# Groq - Fast inference with Llama models (get key from console.groq.com)
GROQ_API_KEY=

# HuggingFace - Access to thousands of models (get key from huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=

# TogetherAI - Affordable cloud inference (get key from together.ai)
TOGETHERAI_API_KEY=

# OpenRouter - Access to GPT-4, Claude, Gemini, and more (get key from openrouter.ai/keys)
OPENROUTER_API_KEY=

# =============================================================================
# IMAGE GENERATION API KEYS (Optional)
# =============================================================================

# OpenAI API Key for DALL-E image generation (get key from platform.openai.com/api-keys)
OPENAI_API_KEY=

# Stability AI API Key for Stable Diffusion (get key from platform.stability.ai)
STABILITY_API_KEY=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application environment (development or production)
APP_ENV=development

# Debug mode - set to true for detailed error messages (NOT recommended for production)
APP_DEBUG=false

# SSL verification - set to false only for local development with self-signed certificates
VERIFY_SSL=true

# Custom CA bundle path (optional - leave empty for default)
# CA_BUNDLE=

# API request timeout in seconds (default: 120 seconds)
API_TIMEOUT=120

# =============================================================================
# BRANDING CONFIGURATION (Customize per installation)
# =============================================================================

# Your name or company name
DEVELOPER_NAME=Your Name

# Company name
COMPANY_NAME=Your Company

# Company website URL
COMPANY_URL=https://your-company.com

# GitHub username (for community links)
GITHUB_USERNAME=LebToki

# GitHub repository name
GITHUB_REPO=chat-with-ollama
